# Answers a program's password prompt from a root-only file, so the password is never on a command
# line where any local process could read it. Everything else passes through to the person at the
# terminal, including any prompt for their own password.
# Usage: expect -f feed-password.exp <password file> <prompt regex> <command> [argument...]

set handle [open [lindex $argv 0] r]
set password [read -nonewline $handle]
close $handle
set prompt [lindex $argv 1]

set timeout -1
spawn {*}[lrange $argv 2 end]
interact -o -re $prompt { send -- "$password\r" }
catch wait result
exit [lindex $result 3]
